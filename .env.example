# Local Codex is the default and requires no API key:
AI_CAD_PLANNER=codex

# External OpenAI-compatible provider:
AI_CAD_API_BASE=https://api.openai.com/v1
AI_CAD_API_KEY=replace-me
AI_CAD_API_MODEL=gpt-5.6-sol
AI_CAD_API_PROTOCOL=responses
AI_CAD_API_TIMEOUT=240
AI_CAD_API_STRUCTURED_OUTPUTS=true
